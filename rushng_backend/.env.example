# ================================================================
# RUSHNG - Environment Variables
# ================================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here
ENVIRONMENT=production
DEBUG=False

# Database
DATABASE_URL=postgresql://rushng_user:secure_password@localhost:5432/rushng_prod

# JWT
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# CORS
CORS_ORIGINS=https://rushng.com,https://www.rushng.com

# Rate Limiting
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_AUTH=5 per minute
RATELIMIT_JOB_POST=20 per hour

# OPay (Primary)
OPAY_API_KEY=opay_live_xxxxxxxxxxxxx
OPAY_API_SECRET=opay_secret_xxxxxxxxxxxxx
OPAY_BASE_URL=https://api.opay.com/v1

# Paystack (Alternative)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://rushng.com/payment/verify

# Flutterwave (Alternative)
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE_xxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE_xxxxxxxxxxxxx
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_CALLBACK_URL=https://rushng.com/payment/verify

# Brevo (Notifications)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxx
BREVO_SMS_SENDER=RUSHNG
BREVO_EMAIL_FROM=noreply@rushng.com

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Sentry
SENTRY_DSN=https://xxxxxxxxxxxxx@o123456.ingest.sentry.io/1234567

# Security
TALISMAN_ENABLED=True
BCRYPT_LOG_ROUNDS=12

# Account Deletion
ACCOUNT_DELETION_COOLDOWN_DAYS=7
VIOLATION_EXPIRY_DAYS=90

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info